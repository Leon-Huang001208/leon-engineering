{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/guard.mjs\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/harness-hook.mjs\" --phase pre",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/harness-hook.mjs\" --phase post",
            "async": true,
            "timeout": 2
          }
        ]
      }
    ]
  }
}
